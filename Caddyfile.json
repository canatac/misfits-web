{
  "email": "jan.atac@misfits.fr",
  "host": "mail.misfits.ai",
  "port": 443,
  "tls": {
    "issuer": "acme"
  },
  "cors": {
    "origins": ["https://mail.misfits.ai", "https://www.mail.misfits.ai"],
    "methods": ["GET", "POST", "PUT", "DELETE", "OPTIONS"],
    "headers": ["Authorization", "Content-Type", "X-Requested-With"],
    "credentials": true,
    "max_age": 3600
  },
  "routes": {
    "/api/*": {
      "upstream": "http://email-api:8000",
      "cors": {
        "origins": ["https://mail.misfits.ai", "https://www.mail.misfits.ai"],
        "credentials": true
      }
    },
    "/": {
      "upstream": "http://misfits-web:3000"
    }
  },
  "security_headers": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "X-XSS-Protection": "1; mode=block",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Strict-Transport-Security": "max-age=31536000; includeSubDomains",
    "Content-Security-Policy": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://mail.misfits.ai wss://mail.misfits.ai; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
  },
  "rate_limiting": {
    "requests_per_second": 10,
    "burst": 20
  },
  "logging": {
    "level": "INFO",
    "format": "json"
  }
}
